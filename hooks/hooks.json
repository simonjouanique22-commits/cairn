{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "\"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/hooks/cairn.py\"" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "\"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/hooks/cairn.py\"" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [ { "type": "command", "command": "\"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/hooks/cairn.py\"" } ] }
    ],
    "PostToolUse": [
      { "matcher": "TaskCreate|TaskUpdate|Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell|Agent|Task",
        "hooks": [ { "type": "command", "command": "\"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/hooks/cairn.py\"" } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "\"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/hooks/cairn.py\"" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "\"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/hooks/cairn.py\"", "timeout": 900 } ] }
    ]
  }
}
