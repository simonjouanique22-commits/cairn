{
  "name": "cairn",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.9.0",
  "publisher": "local",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#F4F0E8",
    "theme": "light"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "roadmap",
    "tasks",
    "progress"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cairn",
          "title": "Cairn",
          "icon": "media/cairn.svg"
        }
      ]
    },
    "views": {
      "cairn": [
        {
          "id": "cairn.roadmap",
          "name": "Roadmap",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "cairn.open",
        "title": "%command.open%",
        "category": "Cairn"
      },
      {
        "command": "cairn.history",
        "title": "%command.history%",
        "category": "Cairn",
        "icon": "$(history)"
      },
      {
        "command": "cairn.settings",
        "title": "%command.settings%",
        "category": "Cairn",
        "icon": "$(gear)"
      },
      {
        "command": "cairn.refresh",
        "title": "%command.refresh%",
        "category": "Cairn"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cairn.history",
          "when": "view == cairn.roadmap && config.cairn.history",
          "group": "navigation"
        },
        {
          "command": "cairn.settings",
          "when": "view == cairn.roadmap",
          "group": "navigation@9"
        }
      ]
    },
    "configuration": [
      {
        "title": "%config.claude%",
        "properties": {
          "cairn.requireRoadmap": {
            "type": "boolean",
            "default": true,
            "description": "%config.requireRoadmap%",
            "order": 0
          },
          "cairn.threshold": {
            "type": "number",
            "default": 3,
            "minimum": 1,
            "maximum": 50,
            "description": "%config.threshold%",
            "order": 1
          },
          "cairn.planGate": {
            "type": "boolean",
            "default": false,
            "description": "%config.planGate%",
            "order": 2
          },
          "cairn.gateWait": {
            "type": "number",
            "default": 600,
            "minimum": 30,
            "maximum": 840,
            "description": "%config.gateWait%",
            "order": 3
          },
          "cairn.snapshots": {
            "type": "boolean",
            "default": true,
            "description": "%config.snapshots%",
            "order": 4
          },
          "cairn.history": {
            "type": "boolean",
            "default": true,
            "description": "%config.history%",
            "order": 5
          },
          "cairn.historyDays": {
            "type": "number",
            "default": 90,
            "minimum": 1,
            "maximum": 3650,
            "description": "%config.historyDays%",
            "order": 6
          }
        },
        "order": 0
      },
      {
        "title": "%config.view%",
        "properties": {
          "cairn.trail": {
            "type": "boolean",
            "default": true,
            "description": "%config.trail%",
            "order": 0
          },
          "cairn.timeLeft": {
            "type": "boolean",
            "default": true,
            "description": "%config.timeLeft%",
            "order": 1
          },
          "cairn.lines": {
            "type": "boolean",
            "default": true,
            "description": "%config.lines%",
            "order": 2
          },
          "cairn.files": {
            "type": "boolean",
            "default": true,
            "description": "%config.files%",
            "order": 3
          },
          "cairn.steering": {
            "type": "boolean",
            "default": true,
            "description": "%config.steering%",
            "order": 4
          },
          "cairn.sessions": {
            "type": "boolean",
            "default": true,
            "description": "%config.sessions%",
            "order": 5
          },
          "cairn.sticker": {
            "type": "boolean",
            "default": true,
            "description": "%config.sticker%",
            "order": 6
          },
          "cairn.statusBar": {
            "type": "boolean",
            "default": true,
            "description": "%config.statusBar%",
            "order": 7
          },
          "cairn.notifications": {
            "type": "boolean",
            "default": true,
            "description": "%config.notifications%",
            "order": 8
          },
          "cairn.staleHours": {
            "type": "number",
            "default": 2,
            "minimum": 0.1,
            "description": "%config.staleHours%",
            "order": 9
          },
          "cairn.language": {
            "type": "string",
            "enum": [
              "auto",
              "en",
              "fr"
            ],
            "default": "auto",
            "description": "%config.language%",
            "order": 10
          },
          "cairn.palette": {
            "type": "string",
            "enum": [
              "cairn",
              "colorblind",
              "violet",
              "emerald",
              "raspberry",
              "teal"
            ],
            "enumItemLabels": [
              "%config.palette.cairn%",
              "%config.palette.colorblind%",
              "%config.palette.violet%",
              "%config.palette.emerald%",
              "%config.palette.raspberry%",
              "%config.palette.teal%"
            ],
            "default": "cairn",
            "description": "%config.palette%",
            "order": 11
          },
          "cairn.accent": {
            "type": "string",
            "default": "",
            "description": "%config.accent%",
            "order": 12,
            "pattern": "^(#[0-9a-fA-F]{3,8})?$"
          },
          "cairn.pop": {
            "type": "string",
            "default": "",
            "description": "%config.pop%",
            "order": 13,
            "pattern": "^(#[0-9a-fA-F]{3,8})?$"
          }
        },
        "order": 1
      }
    ]
  }
}
