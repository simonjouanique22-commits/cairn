{
  "name": "cairn",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.5.0",
  "publisher": "local",
  "icon": "media/icon.png",
  "galleryBanner": { "color": "#F4F0E8", "theme": "light" },
  "categories": ["Visualization", "Other"],
  "keywords": ["claude", "claude code", "roadmap", "tasks", "progress"],
  "engines": { "vscode": "^1.90.0" },
  "extensionKind": ["workspace"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [{ "id": "cairn", "title": "Cairn", "icon": "media/cairn.svg" }]
    },
    "views": {
      "cairn": [{ "id": "cairn.roadmap", "name": "Roadmap", "type": "webview" }]
    },
    "commands": [
      { "command": "cairn.open", "title": "%command.open%", "category": "Cairn" },
      { "command": "cairn.history", "title": "%command.history%", "category": "Cairn", "icon": "$(history)" },
      { "command": "cairn.settings", "title": "%command.settings%", "category": "Cairn" },
      { "command": "cairn.refresh", "title": "%command.refresh%", "category": "Cairn" }
    ],
    "menus": {
      "view/title": [{ "command": "cairn.history", "when": "view == cairn.roadmap", "group": "navigation" }]
    },
    "configuration": {
      "title": "Cairn",
      "properties": {
        "cairn.accent": { "type": "string", "default": "#2B3BFF", "format": "color", "description": "%config.accent%" },
        "cairn.pop": { "type": "string", "default": "#FF7AD9", "format": "color", "description": "%config.pop%" },
        "cairn.staleHours": { "type": "number", "default": 2, "minimum": 0.1, "description": "%config.staleHours%" },
        "cairn.notifications": { "type": "boolean", "default": true, "description": "%config.notifications%" },
        "cairn.planGate": { "type": "boolean", "default": false, "description": "%config.planGate%" },
        "cairn.language": { "type": "string", "enum": ["auto", "en", "fr"], "default": "auto", "description": "%config.language%" }
      }
    }
  }
}
