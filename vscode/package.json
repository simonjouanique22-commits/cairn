{
  "name": "cairn",
  "displayName": "Cairn — la roadmap de Claude Code",
  "description": "Le plan de Claude Code, pierre après pierre : sa liste de tâches en frise, avec l'avancement en direct.",
  "version": "1.0.0",
  "publisher": "local",
  "icon": "media/icon.png",
  "galleryBanner": { "color": "#0F172A", "theme": "dark" },
  "categories": ["Visualization", "Other"],
  "keywords": ["claude", "claude code", "roadmap", "tasks", "progress"],
  "engines": { "vscode": "^1.90.0" },
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [{ "id": "cairn", "title": "Cairn", "icon": "media/cairn.svg" }]
    },
    "views": {
      "cairn": [{ "id": "cairn.roadmap", "name": "Roadmap", "type": "webview" }]
    }
  }
}
